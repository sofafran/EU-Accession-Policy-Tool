    {
      "item_id": "MKD-RES-2023-001-0029",
      "information_type": "finding",
      "stated_text": "Medium-skilled service and sales workers are paid more in North Macedonia, especially personal care workers who receive almost 50% higher wages than workers in Serbia. The Open Balkan initiative can result in greater mobility of these workers from Serbia to North Macedonia, hence reducing their shortage.",
      "quote_language": "en",
      "translation_en": null,
      "machine_translated": false,
      "summary": "Service and sales workers, especially personal care workers, earn more in North Macedonia; the Initiative may draw them from Serbia, reducing shortages.",
      "location": {

    {
      "item_id": "MKD-RES-2023-001-0002",
      "information_type": "intervention",
      "stated_text": "It stipulates that every resident of the signatory countries has the right to free movement, residence and work in the territory of the three countries. In order to ensure equal access for all residents of these countries, the signatories should simplify the procedures for entry, residence and work in their countries.",
      "quote_language": "en",
      "translation_en": null,
      "machine_translated": false,
      "summary": "The memorandum gives residents of the signatory countries the right to move, reside and work in all three, and obliges signatories to simplify procedures.",

    {
      "item_id": "MKD-RES-2023-001-0018",
      "information_type": "finding",
      "stated_text": "As the Open Balkan Initiative is a three-lateral project of North Macedonia, Serbia and Albania, it is expected that the planning regions bordering the other two countries would benefit the most of the initiative for free labor mobility.",
      "quote_language": "en",
      "translation_en": null,
      "machine_translated": false,
      "summary": "The planning regions bordering Serbia and Albania are expected to benefit most from the Open Balkan free labour mobility initiative.",
      "location": {
